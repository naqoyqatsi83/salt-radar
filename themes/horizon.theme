# salt-radar port of btop++'s horizon.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient
#
# The status, pulse and highlight colors salt-radar adds come from
# the Horizon palette.

theme[main_bg]="#1c1e26"
theme[meter_bg]="#20242b"
theme[bar_bg]="#2b2d34"
theme[popup_bg]="#23252c"
theme[selected_bg]="#282b37"
theme[border]="#3c4246"
theme[border_focus]="#b877db"
theme[div_line]="#3c4246"
theme[main_fg]="#f8f8f2"
theme[inactive_fg]="#666b6c"
theme[label_fg]="#666b6c"
theme[title]="#f8f8f2"
theme[hi_fg]="#f8f8f2"
theme[header_fg]="#dbbee8"
theme[subtitle_fg]="#f8f8f2"
theme[version_fg]="#26bbd9"
theme[hint_fg]="#666b6c"
theme[badge_bg]="#6a574f"
theme[green]="#27d796"
theme[cyan]="#25b2bc"
theme[yellow]="#ffc850"
theme[orange]="#fac29a"
theme[red]="#e95678"
theme[purple]="#b877db"
theme[gradient_start]="#27d796"
theme[gradient_mid]="#fac29a"
theme[gradient_high]="#f28c89"
theme[gradient_end]="#e95678"
theme[mem_gradient_start]="#27d796"
theme[mem_gradient_mid]="#fac29a"
theme[mem_gradient_high]="#f28c89"
theme[mem_gradient_end]="#e95678"
theme[pulse_fresh]="#29d398"
theme[pulse_aging]="#fac29a"
theme[tab_active_bg]="#232630"
theme[tab_active_fg]="#b877db"
theme[tab_inactive_fg]="#666b6c"
theme[tab_separator]="#3c4246"
theme[highlight_1]="#59e1e3"
theme[highlight_2]="#ee64ac"
theme[highlight_3]="#26bbd9"
theme[highlight_4]="#b877db"
