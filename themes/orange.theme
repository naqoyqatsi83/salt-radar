# salt-radar port of btop++'s orange.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# Btop orange theme
# by neocerambyx
#
# A monochrome theme: the status roles btop doesn't have are shades of amber
# too, brighter the more attention a state needs, so a failure (red) is white.

theme[main_bg]="#000000"
theme[meter_bg]="#1b1200"
theme[bar_bg]="#120c00"
theme[popup_bg]="#080500"
theme[selected_bg]="#664200"
theme[border]="#472e00"
theme[border_focus]="#ffa500"
theme[div_line]="#3d2800"
theme[main_fg]="#ffa500"
theme[inactive_fg]="#825400"
theme[label_fg]="#825400"
theme[title]="#ffa500"
theme[hi_fg]="#ffa500"
theme[header_fg]="#ffa500"
theme[subtitle_fg]="#a66c00"
theme[version_fg]="#ffcc66"
theme[hint_fg]="#825400"
theme[badge_bg]="#3d2800"
theme[green]="#996300"
theme[cyan]="#d98a00"
theme[yellow]="#ffbf40"
theme[orange]="#ffe0a0"
theme[red]="#ffffff"
theme[purple]="#cc8400"
theme[gradient_start]="#996300"
theme[gradient_mid]="#cc8400"
theme[gradient_high]="#e69400"
theme[gradient_end]="#ffa500"
theme[mem_gradient_start]="#996300"
theme[mem_gradient_mid]="#cc8400"
theme[mem_gradient_high]="#e69400"
theme[mem_gradient_end]="#ffa500"
theme[pulse_fresh]="#ffcc66"
theme[pulse_aging]="#996300"
theme[tab_active_bg]="#3d2800"
theme[tab_active_fg]="#ffcc66"
theme[tab_inactive_fg]="#825400"
theme[tab_separator]="#3d2800"
theme[highlight_1]="#ffd27f"
theme[highlight_2]="#ff8c1a"
theme[highlight_3]="#fff2d6"
theme[highlight_4]="#ff6000"
