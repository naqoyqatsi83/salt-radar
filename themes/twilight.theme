# salt-radar port of btop++'s twilight.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# The status, pulse and highlight colors salt-radar adds come from the
# TextMate Twilight palette too.

theme[main_bg]="#141414"
theme[meter_bg]="#232323"
theme[bar_bg]="#1e1e1e"
theme[popup_bg]="#181818"
theme[selected_bg]="#3c3c3c"
theme[border]="#494949"
theme[border_focus]="#8f9d6a"
theme[div_line]="#494949"
theme[main_fg]="#a7a7a7"
theme[inactive_fg]="#828282"
theme[label_fg]="#828282"
theme[title]="#dad085"
theme[hi_fg]="#a7a7a7"
theme[header_fg]="#9ca28c"
theme[subtitle_fg]="#b6ab8e"
theme[version_fg]="#7587a6"
theme[hint_fg]="#828282"
theme[badge_bg]="#433423"
theme[green]="#8f9d6a"
theme[cyan]="#7587a6"
theme[yellow]="#dad085"
theme[orange]="#e4ac72"
theme[red]="#cf6a4c"
theme[purple]="#9b859d"
theme[gradient_start]="#8f9d6a"
theme[gradient_mid]="#f9ee98"
