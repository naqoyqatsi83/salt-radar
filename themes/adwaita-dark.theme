theme[main_fg]="#deddda"
theme[inactive_fg]="#77767b"
theme[label_fg]="#77767b"
theme[title]="#deddda"
theme[hi_fg]="#ffffff"
theme[header_fg]="#b0afaf"
theme[subtitle_fg]="#aaaaaa"
theme[version_fg]="#1c71d8"
theme[hint_fg]="#77767b"
