# salt-radar port of btop++'s adwaita-dark.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# Bashtop Adwaita Dark theme
# by k0tran
#
# The status, pulse and highlight colors salt-radar adds come from the GNOME
# (Adwaita) palette too.

theme[main_bg]="#1d1d1d"
theme[meter_bg]="#3c3c3e"
theme[bar_bg]="#2b2a2a"
theme[popup_bg]="#232323"
theme[selected_bg]="#1c60b3"
theme[border]="#77767b"
theme[border_focus]="#77767b"
