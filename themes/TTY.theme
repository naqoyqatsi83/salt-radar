# salt-radar port of btop++'s built-in TTY theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# Only the terminal's 16 ANSI colors, so it looks like your terminal's own
# palette (and works on a Linux console). They can't be blended, so the
# graphs' level colors come in solid bands, as in btop.

theme[main_bg]="black"
theme[meter_bg]="black"
theme[bar_bg]="black"
theme[popup_bg]="black"
theme[selected_bg]="blue"
theme[border]="bright_black"
theme[border_focus]="green"
theme[div_line]="bright_black"
theme[main_fg]="white"
theme[inactive_fg]="bright_black"
theme[label_fg]="bright_black"
theme[title]="bright_white"
theme[hi_fg]="bright_white"
theme[header_fg]="green"
theme[subtitle_fg]="white"
theme[version_fg]="bright_blue"
theme[hint_fg]="bright_black"
theme[badge_bg]="blue"
theme[green]="bright_green"
theme[cyan]="bright_cyan"
theme[yellow]="bright_yellow"
theme[orange]="yellow"
theme[red]="bright_red"
theme[purple]="bright_magenta"
theme[gradient_start]="bright_green"
theme[gradient_mid]="bright_yellow"
theme[gradient_high]="yellow"
theme[gradient_end]="bright_red"
theme[mem_gradient_start]="cyan"
theme[mem_gradient_mid]="bright_blue"
theme[mem_gradient_high]="yellow"
theme[mem_gradient_end]="bright_red"
theme[pulse_fresh]="green"
theme[pulse_aging]="yellow"
theme[tab_active_bg]="blue"
theme[tab_active_fg]="bright_white"
theme[tab_inactive_fg]="bright_black"
theme[tab_separator]="bright_black"
theme[highlight_1]="bright_blue"
theme[highlight_2]="bright_magenta"
theme[highlight_3]="cyan"
theme[highlight_4]="magenta"
