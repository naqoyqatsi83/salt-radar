# salt-radar port of btop++'s elementarish.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# Theme: Elementarish
# (inspired by Elementary OS)
# By: Dennis Mayr
#
# The status, pulse and highlight colors salt-radar adds come from
# the Solarized accents it is built on.

theme[main_bg]="#333333"
theme[meter_bg]="#444c4f"
theme[bar_bg]="#40403e"
theme[popup_bg]="#393838"
theme[selected_bg]="#2b6c99"
theme[border]="#657b83"
theme[border_focus]="#657b83"
theme[div_line]="#657b83"
theme[main_fg]="#eee8d5"
theme[inactive_fg]="#6c8087"
