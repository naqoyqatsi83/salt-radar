theme[title]="#eee8d5"
theme[hi_fg]="#eee8d5"
theme[header_fg]="#b0b7b0"
theme[subtitle_fg]="#aab2ac"
theme[version_fg]="#268ad0"
theme[hint_fg]="#6c8087"
theme[badge_bg]="#7a5636"
theme[green]="#859900"
theme[cyan]="#268ad0"
theme[yellow]="#b28602"
theme[orange]="#ff963c"
theme[red]="#d84f4c"
theme[purple]="#6c71c4"
theme[gradient_start]="#859900"
