# salt-radar port of btop++'s greyscale.theme
# (https://github.com/aristocratos/btop, Apache-2.0)
#
# Bashtop grayscale theme
# by aristocratos
#
# The status roles btop doesn't have (green/cyan/yellow/orange/red, pulse,
# highlights) are shades of grey too: the more attention a state needs, the
# brighter it is, so a failure (red) is white.

theme[main_bg]="#000000"
theme[meter_bg]="#111111"
theme[bar_bg]="#0d0d0d"
theme[popup_bg]="#060606"
theme[selected_bg]="#404040"
theme[border]="#373737"
theme[border_focus]="#909090"
theme[div_line]="#303030"
theme[main_fg]="#bbbbbb"
theme[inactive_fg]="#5a5a5a"
theme[label_fg]="#5a5a5a"
theme[title]="#cccccc"
theme[hi_fg]="#bbbbbb"
theme[header_fg]="#a8a8a8"
theme[subtitle_fg]="#767676"
theme[version_fg]="#8a8a8a"
theme[hint_fg]="#5a5a5a"
theme[badge_bg]="#333333"
theme[green]="#8c8c8c"
theme[cyan]="#b4b4b4"
theme[yellow]="#d2d2d2"
theme[orange]="#e6e6e6"
theme[red]="#ffffff"
theme[purple]="#a0a0a0"
theme[gradient_start]="#626262"
theme[gradient_mid]="#a8a8a8"
theme[gradient_high]="#d4d4d4"
theme[gradient_end]="#ffffff"
theme[mem_gradient_start]="#626262"
theme[mem_gradient_mid]="#a8a8a8"
theme[mem_gradient_high]="#d4d4d4"
theme[mem_gradient_end]="#ffffff"
theme[pulse_fresh]="#d4d4d4"
theme[pulse_aging]="#808080"
theme[tab_active_bg]="#262626"
theme[tab_active_fg]="#909090"
theme[tab_inactive_fg]="#5a5a5a"
theme[tab_separator]="#303030"
theme[highlight_1]="#ffffff"
theme[highlight_2]="#d0d0d0"
theme[highlight_3]="#a8a8a8"
theme[highlight_4]="#8a8a8a"
