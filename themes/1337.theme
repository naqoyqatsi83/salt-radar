# salt-radar theme from the "1337" color scheme
# (originally a Sublime Text color scheme, "1337 Color Scheme"; palette as
# published by its IntelliJ port, https://github.com/2chevskii/intellij-theme-1337)
#
# Near-black background with bright Monokai-like accents: lime for success,
# cyan for changes, amber and orange for warnings, red for failures; blues,
# magenta and purple for highlighted terms.

theme[main_bg]="#191919"
theme[meter_bg]="#232323"
theme[bar_bg]="#1f1f1f"
theme[popup_bg]="#202020"
theme[selected_bg]="#515151"
theme[border]="#3b3a32"
theme[border_focus]="#66a9ec"
theme[div_line]="#3d3d3d"
theme[main_fg]="#f8f8f2"
theme[inactive_fg]="#6d6d6d"
theme[label_fg]="#999999"
theme[title]="#ffffff"
theme[hi_fg]="#ffffff"
theme[header_fg]="#8cdaff"
theme[subtitle_fg]="#999999"
theme[version_fg]="#66d9ef"
theme[hint_fg]="#6d6d6d"
theme[badge_bg]="#5c3b12"
theme[green]="#a6e22e"
theme[cyan]="#66d9ef"
theme[yellow]="#fab85a"
theme[orange]="#ff8942"
theme[red]="#ff5e5e"
theme[purple]="#e5a5e0"
theme[gradient_start]="#a6e22e"
theme[gradient_mid]="#fab85a"
theme[gradient_high]="#ff8942"
theme[gradient_end]="#f92649"
theme[mem_gradient_start]="#6699cc"
theme[mem_gradient_mid]="#66a9ec"
theme[mem_gradient_high]="#ff8942"
theme[mem_gradient_end]="#f92649"
theme[pulse_fresh]="#a6e22e"
theme[pulse_aging]="#ff8942"
theme[tab_active_bg]="#3d3d3d"
theme[tab_active_fg]="#fab85a"
theme[tab_inactive_fg]="#6d6d6d"
theme[tab_separator]="#3d3d3d"
theme[highlight_1]="#66a9ec"
theme[highlight_2]="#cd5ac5"
theme[highlight_3]="#8cdaff"
theme[highlight_4]="#d699ff"
