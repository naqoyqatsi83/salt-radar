# salt-radar.toml — configuration file for salt-radar
#
# salt-radar looks for ./salt-radar.toml in the directory you launch it
# from first; if that's not present, it falls back to
# $XDG_CONFIG_HOME/salt-radar/salt-radar.toml (usually
# ~/.config/salt-radar/salt-radar.toml), creating the directory on first
# save from the in-app Config Editor (F3).
# All settings are optional; defaults are shown below.

[salt]
# Path to Salt master configuration file
# master_config = "/etc/salt/master"

# Python binary that has the `salt` package installed
# python_bin = "/opt/saltstack/salt/bin/python3"

# Path to the bundled salt-radar-agent Python script
# agent_path = "/usr/share/salt-radar/salt_radar_agent.py"

[refresh]
# How often (in seconds) to refresh dashboard collector data
# dashboard_secs = 2

# How often to refresh minion cache list from the agent
# minions_secs = 5

# How often to re-fetch config snapshot from the agent
# config_secs = 60

[events]
# Maximum number of events to keep in the ring buffer
# buffer_size = 10000

# Maximum number of events to keep in the Event Sniffer's own buffer
# sniffer_buffer_size = 1000

[alerts]
# Seconds after which a minion is considered "stale" (not seen)
# stale_minion_secs = 3600

# Seconds after which a pending key triggers an alert
# pending_key_secs = 3600

# Seconds after which a job is considered a straggler
# job_straggler_secs = 120

# Disk usage percentage threshold for alert
# disk_usage_pct = 85.0

# Auth events/sec threshold for the "Reauth storm" alert (fires only when
# combined with worker_saturation_pct also being exceeded)
# auth_storm_rate_per_sec = 5.0

# Worker pool CPU busy percentage threshold for the "Reauth storm" alert
# worker_saturation_pct = 85.0

# New pending keys per minute that triggers a "Pending key churn" alert
# pending_key_churn_per_min = 10

# Restart/flap count over a rolling 24h window that triggers a "Service
# flapping" alert for a salt-* systemd unit
# service_flap_threshold_24h = 3

# Sustained memory growth rate (MB/hour, linear-regression slope over sampled
# history) that triggers a "Service memory growth" alert for a salt-* unit
# service_mem_growth_mb_per_hour = 50.0

# Absolute per-service RSS threshold (MB) for the "Service memory high" alert
# — fires independent of growth rate, catching an already-large, slow leak.
# Set to 0 to disable this check.
# service_mem_abs_threshold_mb = 2048.0

# Per-service RSS as a percentage of total system memory for the "Service
# memory high" alert. Either this or service_mem_abs_threshold_mb crossing
# is enough to fire. Set to 0 to disable this check.
# service_mem_pct_threshold = 8.0

# Per-unit overrides for the standard bundled Salt services, since e.g.
# salt-master legitimately runs with a much larger working set than
# salt-minion/salt-api/salt-syndic. Each 0.0 means "no override, fall back
# to service_mem_abs_threshold_mb / service_mem_pct_threshold above".
# service_mem_abs_threshold_master_mb = 0.0
# service_mem_pct_threshold_master = 0.0
# service_mem_abs_threshold_minion_mb = 0.0
# service_mem_pct_threshold_minion = 0.0
# service_mem_abs_threshold_api_mb = 0.0
# service_mem_pct_threshold_api = 0.0
# service_mem_abs_threshold_syndic_mb = 0.0
# service_mem_pct_threshold_syndic = 0.0

[dashboard]
# Source for the Dashboard ZMQ panel's latency figure:
#   "agent_ipc"    - local Rust<->Python agent round-trip (a liveness check,
#                    not a measurement of Salt's own transport)
#   "job_ping"     - periodically dispatches a real test.ping and times
#                    dispatch -> first return over the actual event bus
#   "master_stats" - reads Salt's own master_stats events (requires
#                    master_stats: True in the Salt master's own config)
# zmq_latency_source = "agent_ipc"

# Which of the Dashboard's bottom sparkline panels are shown — all five
# default on.
# show_zmq_graph = true
# show_events_graph = true
# show_activity_graph = true
# show_cpu_graph = true
# show_mem_graph = true

# Stacking order of the sparkline panels above, as a comma-separated list of
# keys: cpu, mem, zmq, events, activity. Unrecognized/duplicate keys are
# ignored; any panel missing from the list is appended after the ones named.
# graph_order = "cpu,mem,zmq,events,activity"
