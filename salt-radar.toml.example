# salt-radar.toml — configuration file for salt-radar
#
# salt-radar looks for ./salt-radar.toml in the directory you launch it
# from first; if that's not present, it falls back to
# $XDG_CONFIG_HOME/salt-radar/salt-radar.toml (usually
# ~/.config/salt-radar/salt-radar.toml), creating the directory on first
# save from the in-app Config Editor (F3).
# All settings are optional; defaults are shown below.

[salt]
# Path to Salt master configuration file
# master_config = "/etc/salt/master"

# Python binary that has the `salt` package installed
# python_bin = "/opt/saltstack/salt/bin/python3"

# Path to the bundled salt-radar-agent Python script
# agent_path = "/usr/share/salt-radar/salt_radar_agent.py"

[refresh]
# How often (in seconds) to refresh dashboard collector data
# dashboard_secs = 2

# How often to refresh minion cache list from the agent
# minions_secs = 5

# How often to re-fetch config snapshot from the agent
# config_secs = 60

# How often (ms) the screen redraws and timed work runs, 500-30000. Also
# changed in steps of 500 with '-'/'+'; the header shows it as -2000ms+.
# tick_ms = 2000

# Cap on what redraws send to the terminal, in KB/s; 0 = no cap. Through a
# slow link, such as an SSH proxy that records sessions, a busy master's
# scrolling lists can send more than the link passes on, and the whole
# connection lags (other windows and tmux on it too). Over the cap, redraws
# wait (key presses still redraw at once); the header shows the cap, yellow
# while a redraw is waiting. Try 4-8 behind such a proxy.
# max_output_kbs = 0

[events]
# Maximum number of events to keep in the ring buffer
# buffer_size = 10000

# Maximum number of events to keep in the Event Sniffer's own buffer
# sniffer_buffer_size = 1000

# Which Events list columns are shown, and in what order (comma-separated;
# any key left out is hidden). Keys: local, utc, tag, minion. Also editable
# with 'v' on the Events tab. Events can't be sorted -- it's a live tail.
# event_columns = "local,utc,tag"

[alerts]
# Seconds after which a minion is considered "stale" (not seen)
# stale_minion_secs = 3600

# Seconds after which a pending key triggers an alert
# pending_key_secs = 3600

# Seconds after which a job is considered a straggler
# job_straggler_secs = 120

# Disk usage percentage threshold for alert
# disk_usage_pct = 85.0

# Auth events/sec threshold for the "Reauth storm" alert (fires only when
# combined with worker_saturation_pct also being exceeded)
# auth_storm_rate_per_sec = 5.0

# Worker pool CPU busy percentage threshold for the "Reauth storm" alert
# worker_saturation_pct = 85.0

# New pending keys per minute that triggers a "Pending key churn" alert
# pending_key_churn_per_min = 10

# Restart/flap count over a rolling 24h window that triggers a "Service
# flapping" alert for a salt-* systemd unit
# service_flap_threshold_24h = 3

# Sustained memory growth rate (MB/hour, linear-regression slope over sampled
# history) that triggers a "Service memory growth" alert for a salt-* unit
# service_mem_growth_mb_per_hour = 50.0

# Absolute per-service RSS threshold (MB) for the "Service memory high" alert
# — fires independent of growth rate, catching an already-large, slow leak.
# Set to 0 to disable this check.
# service_mem_abs_threshold_mb = 2048.0

# Per-service RSS as a percentage of total system memory for the "Service
# memory high" alert. Either this or service_mem_abs_threshold_mb crossing
# is enough to fire. Set to 0 to disable this check.
# service_mem_pct_threshold = 8.0

# Per-unit overrides for the standard bundled Salt services, since e.g.
# salt-master legitimately runs with a much larger working set than
# salt-minion/salt-api/salt-syndic. Each 0.0 means "no override, fall back
# to service_mem_abs_threshold_mb / service_mem_pct_threshold above".
# service_mem_abs_threshold_master_mb = 0.0
# service_mem_pct_threshold_master = 0.0
# service_mem_abs_threshold_minion_mb = 0.0
# service_mem_pct_threshold_minion = 0.0
# service_mem_abs_threshold_api_mb = 0.0
# service_mem_pct_threshold_api = 0.0
# service_mem_abs_threshold_syndic_mb = 0.0
# service_mem_pct_threshold_syndic = 0.0

# salt-api's POST /login p95 processing time (seconds) that triggers the
# "API auth latency" alert — needs the salt-api panel's collect_stats setup,
# see [api] below and the Dashboard section in README.
# api_auth_latency_warn_secs = 3.0

# Which Alerts columns are shown, and in what order. Keys: severity, rule,
# description, since, count. Also editable with 'v' on the Alerts tab.
# alert_columns = "severity,rule,description"

[api]
# Rolling window (in observed requests) backing the salt-api panel's error
# rate and POST /login p50/p95 latency figures
# stats_window = 200

# Max entries kept in the API tab's live request log before the oldest are
# evicted, independent of the age-based prune below
# log_cap = 1000

# Entries older than this (seconds) are dropped from the API tab's request
# log every poll regardless of how far under log_cap it is
# log_max_age_secs = 3600

# Filter salt-radar's own GET /stats poll out of the API tab's request log
# -- left in, it would add one entry per poll tick and drown out real
# traffic. Set to false to see it too.
# hide_stats_polls = true

# How the agent authenticates to salt-api's /stats endpoint:
#   "none"      - relies on stats_disable_auth: True in the master config
#                 (see README's security note on that tradeoff)
#   "plaintext" - logs in via eauth using stats_auth_username/
#                 stats_auth_password below, read straight from this file
#                 -- INSECURE: stored and passed to the agent as plain text
#   "pillar"    - logs in via eauth using credentials resolved from two
#                 independent pillar paths, compiled master-side with no
#                 live round-trip to any minion -- the credential never
#                 touches this file or the Rust process
# See the README for the minimal eauth ACL scope for the login account
# (an empty permission list can read /stats but run nothing else).
# stats_auth_mode = "none"

# eauth backend the login uses (pam, ldap, file, ...). Only meaningful when
# stats_auth_mode is "plaintext" or "pillar".
# stats_auth_eauth = "pam"

# Plaintext credentials for stats_auth_mode = "plaintext". See its own
# comment above for the security tradeoff.
# stats_auth_username = ""
# stats_auth_password = ""

# Colon-delimited pillar paths resolving directly to the username/password
# strings, for stats_auth_mode = "pillar" -- like two independent
# pillar.get calls, e.g. "salt_radar:api_user" / "salt_radar:api_password"
# for a pillar shaped salt_radar: {api_user: ..., api_password: ...}.
# Compiled master-side for this master's own local minion ID -- the same
# one `salt-call pillar.get` would use on this box, not something you
# configure -- so a top.sls entry keyed to this master's own minion ID
# (not '*', which would hand it to every minion) is all that's needed.
# Requires a minion co-located with the master.
# stats_auth_username_pillar_path = ""
# stats_auth_password_pillar_path = ""

# Which API request log columns are shown, and in what order. Keys: age,
# method, client, path, status, time. Also editable with 'v' on the API tab.
# request_columns = "age,method,client,path,status,time"

[dashboard]
# Source for the Dashboard ZMQ panel's latency figure:
#   "agent_ipc"    - local Rust<->Python agent round-trip (a liveness check,
#                    not a measurement of Salt's own transport)
#   "job_ping"     - periodically dispatches a real test.ping and times
#                    dispatch -> first return over the actual event bus
#   "master_stats" - reads Salt's own master_stats events (requires
#                    master_stats: True in the Salt master's own config)
# zmq_latency_source = "agent_ipc"

# Latency (ms) at the top of the ZMQ graph. The graph uses a log scale from 0
# up to this value, colored green -> yellow -> amber -> red by height, so the
# top (red) means "this slow is bad"; slower samples are clipped there.
# 0 = a default for the source above: agent_ipc 100, job_ping 1000,
# master_stats 500.
# zmq_latency_ceiling_ms = 0

# Which of the Dashboard's bottom sparkline panels are shown — all five
# default on.
# show_zmq_graph = true
# show_events_graph = true
# show_activity_graph = true
# show_cpu_graph = true
# show_mem_graph = true

# Stacking order of the sparkline panels above, as a comma-separated list of
# keys: cpu, mem, zmq, events, activity. Unrecognized/duplicate keys are
# ignored; any panel missing from the list is appended after the ones named.
# graph_order = "cpu,mem,zmq,events,activity"

# How the sparklines are drawn: "dots" or "bars". Also toggled with 'm'.
# graph_style = "dots"

# Which of the Dashboard's other (non-sparkline) panels are shown — all six
# default on. salt-api still only ever renders when the process is actually
# detected on this master; this just adds an opt-out on top of that.
# show_host_resources = true
# show_services = true
# show_key_status = true
# show_event_types = true
# show_job_pulse = true
# show_salt_api = true

[minions]
# Whether the Minions tab's Fleet Overview panel (OS/Salt-version/
# architecture breakdown) scopes itself to the active list filter, or always
# aggregates the whole fleet. Toggled live with 'f' on the Minions tab; this
# is just the startup default.
# follow_filter = true

# Which Minions list columns are shown, and in what order. Keys: id, key,
# os, salt, arch, seen, fail_pct (share of the minion's last 50 returns
# that failed). Also editable with 'v' on the Minions tab.
# minion_columns = "id,key,os,salt"

[export]
# Default directory the 's'/'S' ("save to file") action writes into, from
# any popup that also supports 'y'/'Y' (clipboard copy). '~' and '~/...'
# are expanded against $HOME at save time. The save prompt proposes a
# filename based on what's being saved and lets you edit it before
# confirming; it also warns if that filename already exists in this
# directory before you overwrite it.
# save_dir = "~"

[jobs]
# How long (seconds) a Job Detail lookup (salt-run jobs.lookup_jid) may run
# before it is reported as timed out. Jobs with thousands of returns (e.g.
# grains.items across a large fleet) can take a minute or more to read back.
# lookup_timeout_secs = 300

# Which columns the Live Jobs / Job Cache tables show, and in what order, as
# comma-separated column keys -- any key left out is hidden. Also editable
# with 'v' on the Jobs tab.
#   live_columns:  jid, fun, args, target, source, tgt, ok, fail, wait, started
#   cache_columns: jid, user, started, target, fun, args
# live_columns = "jid,fun,args,target,source,tgt,ok,fail,wait"
# cache_columns = "jid,user,started,target,fun,args"

[ui]
# Color theme: "Default" (built in), the name of a *.theme file in
# /usr/share/salt-radar/themes/ or ~/.config/salt-radar/themes/, or a path to
# one. See salt-radar.theme.example for the format and every key.
# color_theme = "Default"

# false leaves the screen background to the terminal (e.g. transparency)
# instead of the theme's; popups and the cursor bar keep theirs.
# theme_background = true

# How strongly the screen behind a popup is dimmed (faded toward the theme's
# background), 0-100%. 0 turns dimming off.
# popup_dim_pct = 70

# Ask before quitting with 'q' (Ctrl+C always quits at once). Keeps extra 'q'
# presses meant for a popup -- e.g. while the screen lags -- from quitting.
# confirm_quit = true

# Mouse capture (clicks, wheel scrolling). Also toggled with F2.
# mouse = true

# Width of the left panel on the tabs split in two side by side, in percent
# (20-80). Also moved 1% at a time with Ctrl+Left/Right on the tab itself.
# minions_split_pct = 55
# events_split_pct = 50
# jobs_split_pct = 55
# api_split_pct = 65
# pulse_split_pct = 65
# master_split_pct = 55
